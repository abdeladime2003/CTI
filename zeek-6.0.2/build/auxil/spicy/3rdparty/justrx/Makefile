	cd /home/abdo/Cti_Project/zeek-6.0.2/build && $(MAKE) $(MAKESILENT) -f auxil/spicy/3rdparty/justrx/CMakeFiles/jrx-objects.dir/build.make auxil/spicy/3rdparty/justrx/CMakeFiles/jrx-objects.dir/src/util.c.i
.PHONY : src/util.c.i

src/util.s: src/util.c.s
.PHONY : src/util.s

# target to generate assembly for a file
src/util.c.s:
	cd /home/abdo/Cti_Project/zeek-6.0.2/build && $(MAKE) $(MAKESILENT) -f auxil/spicy/3rdparty/justrx/CMakeFiles/jrx-objects.dir/build.make auxil/spicy/3rdparty/justrx/CMakeFiles/jrx-objects.dir/src/util.c.s
.PHONY : src/util.c.s

